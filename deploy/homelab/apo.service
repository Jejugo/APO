# APO daemon (M6.6). Instalado em /etc/systemd/system/apo.service pelo install.sh.
[Unit]
Description=APO — orquestrador de agentes de código
Documentation=file:///opt/apo/docs/homelab.md
After=network-online.target postgresql.service tailscaled.service
Wants=network-online.target tailscaled.service
Requires=postgresql.service

[Service]
Type=simple
User=apo
Group=apo
WorkingDirectory=/home/apo
Environment=HOME=/home/apo
Environment=NODE_ENV=production
# Node 24 isolado (/opt/node24) na frente: claude/codex do APO, com versão fixa.
# ~/.local/bin por último só para o agy (opt-in, se atualiza sozinho), sem
# deixar outro codex/claude dali passar na frente.
Environment=PATH=/opt/node24/bin:/usr/local/bin:/usr/bin:/bin:/home/apo/.local/bin
ExecStart=/opt/node24/bin/node /opt/apo/apps/daemon/dist/main.js
Restart=on-failure
RestartSec=5
# Stop/restart mata a árvore inteira (workers incluídos) pelo cgroup.
KillMode=control-group
TimeoutStopSec=30

# Hardening: o daemon (e os workers que ele lança) só escrevem em /home/apo;
# o resto da máquina é só leitura e as outras homes nem aparecem.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/home/apo
ReadWritePaths=/home/apo
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
# Sem RestrictNamespaces: o sandbox do Codex (bubblewrap) cria namespaces de
# usuário/mount para confinar a escrita do worker. Com RestrictNamespaces=yes o
# bwrap falha, o worker não escreve nada e ainda assim termina "com sucesso"
# (achado do E2E real na VM).
LockPersonality=yes
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=multi-user.target
