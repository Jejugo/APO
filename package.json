{
  "name": "apo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:up": "docker compose -f docker/compose.yaml up -d",
    "db:down": "docker compose -f docker/compose.yaml down",
    "db:migrate": "pnpm --filter @apo/db run migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "24.0.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
